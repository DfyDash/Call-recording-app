# --- Server ---
PORT=3000

# Shared secret GHL's webhook URL must include as ?token=... so the
# ingestion endpoint isn't wide open on the public internet. This is
# NOT a compliance control -- just a basic sanity check for the prototype.
WEBHOOK_TOKEN=change-me-to-a-long-random-string

# --- Database (Postgres) ---
# Local dev default matches docker-compose.yml. Point this at RDS later.
DATABASE_URL=postgres://vault:vault@localhost:5432/call_recording_vault
# RDS requires SSL by default. Set to "require" when DATABASE_URL points at RDS,
# leave unset for local/docker-compose Postgres (which doesn't speak SSL).
PGSSLMODE=

# --- Recording storage ---
# "local" (default) writes files under STORAGE_LOCAL_DIR.
# "s3" uploads to S3_BUCKET using the standard AWS SDK credential chain.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/recordings

S3_BUCKET=
S3_REGION=us-east-1

# --- GHL API (for fetching call recordings) ---
# The "Call Completed" workflow trigger has no recording-URL merge field at
# all, so recordings are fetched via GHL's own API instead. Generate a
# Private Integration token in the sub-account: Settings -> Private
# Integrations -> Create, with the conversations/message.readonly and
# conversations.readonly scopes. GHL_LOCATION_ID is the sub-account's
# location ID (visible in the browser URL or Settings -> Business Info).
# Leave both blank to skip recording fetch entirely (metadata-only mode).
GHL_API_TOKEN=
GHL_LOCATION_ID=
